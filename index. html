<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b1020">
<meta name="description" content="CineFlow - Gestion intelligente de contenu vidéo">
<title>CineFlow</title>

<style>
:root{
  --bg:#080c18;
  --panel:#101729;
  --panel2:#151e34;
  --card:#18233b;
  --border:#263452;
  --text:#f7f9ff;
  --muted:#8f9bb5;
  --primary:#6c5ce7;
  --primary2:#8b7cff;
  --success:#20c997;
  --warning:#ffb020;
  --danger:#ff5d73;
  --info:#35a7ff;
  --shadow:0 18px 50px rgba(0,0,0,.25);
  --radius:18px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:
    radial-gradient(circle at 15% 0%,rgba(108,92,231,.16),transparent 28%),
    radial-gradient(circle at 90% 10%,rgba(53,167,255,.10),transparent 25%),
    var(--bg);
  color:var(--text);
  min-height:100vh;
}

button,
input,
textarea,
select{
  font:inherit;
}

button{
  cursor:pointer;
}

a{
  color:inherit;
  text-decoration:none;
}

.hidden{
  display:none!important;
}

/* APP */
.app{
  min-height:100vh;
}

/* SIDEBAR */
.sidebar{
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  width:250px;
  background:rgba(10,15,29,.96);
  border-right:1px solid var(--border);
  padding:24px 16px;
  z-index:100;
  overflow-y:auto;
}

.logo{
  display:flex;
  align-items:center;
  gap:12px;
  padding:4px 10px 28px;
}

.logo-icon{
  width:44px;
  height:44px;
  border-radius:13px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,var(--primary),var(--info));
  font-size:23px;
  box-shadow:0 10px 25px rgba(108,92,231,.3);
}

.logo strong{
  font-size:22px;
  letter-spacing:-.5px;
}

.logo small{
  display:block;
  color:var(--muted);
  font-size:10px;
  margin-top:2px;
}

.nav-title{
  color:#596681;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:1.2px;
  padding:12px 12px 8px;
}

.nav-btn{
  width:100%;
  border:0;
  background:transparent;
  color:#aeb8ce;
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px;
  border-radius:12px;
  margin:3px 0;
  text-align:left;
  transition:.2s;
}

.nav-btn:hover{
  background:#151e34;
  color:white;
}

.nav-btn.active{
  background:linear-gradient(90deg,rgba(108,92,231,.24),rgba(108,92,231,.08));
  color:white;
  border:1px solid rgba(108,92,231,.28);
}

.nav-icon{
  width:22px;
  text-align:center;
}

.sidebar-bottom{
  margin-top:28px;
  padding:14px;
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:15px;
}

.sidebar-bottom p{
  color:var(--muted);
  font-size:12px;
  line-height:1.5;
}

.status-dot{
  display:inline-block;
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--success);
  margin-right:6px;
}

/* MAIN */
.main{
  margin-left:250px;
  min-height:100vh;
}

.topbar{
  position:sticky;
  top:0;
  z-index:50;
  height:76px;
  padding:0 30px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:rgba(8,12,24,.82);
  backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(38,52,82,.7);
}

.mobile-menu{
  display:none;
  border:1px solid var(--border);
  background:var(--panel);
  color:white;
  border-radius:10px;
  width:40px;
  height:40px;
}

.page-title h1{
  font-size:23px;
}

.page-title p{
  color:var(--muted);
  font-size:12px;
  margin-top:3px;
}

.top-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.icon-btn{
  width:40px;
  height:40px;
  border-radius:11px;
  border:1px solid var(--border);
  background:var(--panel);
  color:white;
  position:relative;
}

.icon-btn:hover{
  border-color:#3d4e75;
}

.notification-dot{
  position:absolute;
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--danger);
  top:8px;
  right:8px;
}

.profile-mini{
  display:flex;
  align-items:center;
  gap:9px;
  padding-left:8px;
}

.avatar{
  width:38px;
  height:38px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,#292f52,#6c5ce7);
}

.profile-mini span{
  font-size:13px;
  font-weight:700;
}

.content{
  padding:30px;
  max-width:1600px;
  margin:auto;
}

/* COMMON */
.section{
  display:none;
}

.section.active{
  display:block;
}

.grid{
  display:grid;
  gap:18px;
}

.grid-4{
  grid-template-columns:repeat(4,1fr);
}

.grid-3{
  grid-template-columns:repeat(3,1fr);
}

.grid-2{
  grid-template-columns:repeat(2,1fr);
}

.card{
  background:linear-gradient(145deg,rgba(24,35,59,.96),rgba(15,23,42,.96));
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:20px;
  box-shadow:var(--shadow);
}

.card-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:18px;
}

.card-title{
  font-size:15px;
  font-weight:750;
}

.muted{
  color:var(--muted);
}

.small{
  font-size:12px;
}

.btn{
  border:0;
  border-radius:11px;
  padding:10px 15px;
  color:white;
  background:#222e49;
  transition:.2s;
  font-weight:650;
}

.btn:hover{
  transform:translateY(-1px);
  filter:brightness(1.1);
}

.btn-primary{
  background:linear-gradient(135deg,var(--primary),var(--primary2));
}

.btn-success{
  background:var(--success);
  color:#06150f;
}

.btn-danger{
  background:rgba(255,93,115,.13);
  color:#ff8b9b;
  border:1px solid rgba(255,93,115,.25);
}

.btn-info{
  background:rgba(53,167,255,.13);
  color:#74c5ff;
  border:1px solid rgba(53,167,255,.25);
}

.badge{
  display:inline-flex;
  align-items:center;
  padding:5px 9px;
  border-radius:30px;
  font-size:10px;
  font-weight:750;
}

.badge-success{
  background:rgba(32,201,151,.12);
  color:#52dfb3;
}

.badge-warning{
  background:rgba(255,176,32,.12);
  color:#ffc75b;
}

.badge-info{
  background:rgba(53,167,255,.12);
  color:#70c3ff;
}

.badge-purple{
  background:rgba(108,92,231,.15);
  color:#aaa0ff;
}

/* DASHBOARD */
.welcome{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  padding:25px;
  border-radius:22px;
  margin-bottom:20px;
  background:
    radial-gradient(circle at 90% 0%,rgba(108,92,231,.3),transparent 35%),
    linear-gradient(135deg,#121b31,#101728);
  border:1px solid var(--border);
}

.welcome h2{
  font-size:26px;
  margin-bottom:6px;
}

.welcome p{
  color:var(--muted);
  font-size:13px;
}

.welcome-icon{
  font-size:55px;
}

.stat-card{
  position:relative;
  overflow:hidden;
}

.stat-icon{
  width:42px;
  height:42px;
  border-radius:12px;
  display:grid;
  place-items:center;
  background:rgba(108,92,231,.13);
  margin-bottom:15px;
}

.stat-value{
  font-size:27px;
  font-weight:800;
}

.stat-label{
  color:var(--muted);
  font-size:12px;
  margin-top:4px;
}

.stat-change{
  margin-top:12px;
  font-size:11px;
  color:var(--success);
}

.chart{
  height:220px;
  display:flex;
  align-items:flex-end;
  gap:12px;
  padding:20px 5px 5px;
}

.bar-wrap{
  flex:1;
  height:100%;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  align-items:center;
  gap:7px;
}

.bar{
  width:70%;
  max-width:38px;
  border-radius:7px 7px 3px 3px;
  background:linear-gradient(180deg,var(--primary2),var(--primary));
  min-height:5px;
}

.bar-label{
  font-size:10px;
  color:var(--muted);
}

.activity{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px 0;
  border-bottom:1px solid rgba(38,52,82,.55);
}

.activity:last-child{
  border-bottom:0;
}

.activity-icon{
  width:38px;
  height:38px;
  border-radius:11px;
  display:grid;
  place-items:center;
  background:#202c47;
}

.activity-text{
  flex:1;
}

.activity-text strong{
  display:block;
  font-size:12px;
}

.activity-text span{
  color:var(--muted);
  font-size:10px;
}

/* VIDEOS */
.toolbar{
  display:flex;
  flex-wrap:wrap;
  justify-content:space-between;
  gap:12px;
  margin-bottom:20px;
}

.toolbar-left,
.toolbar-right{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
}

.input,
.select,
.textarea{
  width:100%;
  background:#0c1324;
  color:white;
  border:1px solid var(--border);
  border-radius:11px;
  padding:11px 12px;
  outline:none;
}

.input:focus,
.select:focus,
.textarea:focus{
  border-color:var(--primary);
}

.search{
  min-width:240px;
}

.video-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.video-card{
  overflow:hidden;
  padding:0;
}

.video-thumb{
  height:165px;
  display:grid;
  place-items:center;
  font-size:43px;
  background:
    linear-gradient(135deg,rgba(108,92,231,.55),rgba(53,167,255,.22)),
    #141d33;
  position:relative;
}

.video-duration{
  position:absolute;
  right:9px;
  bottom:9px;
  background:rgba(0,0,0,.75);
  padding:4px 6px;
  border-radius:6px;
  font-size:10px;
}

.video-body{
  padding:15px;
}

.video-body h3{
  font-size:14px;
  margin-bottom:6px;
}

.video-body p{
  color:var(--muted);
  font-size:11px;
  line-height:1.5;
}

.video-meta{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:13px;
}

.platforms{
  display:flex;
  gap:5px;
}

.platform{
  width:25px;
  height:25px;
  display:grid;
  place-items:center;
  border-radius:7px;
  background:#202c47;
  font-size:12px;
}

/* PLATFORMES */
.platform-card{
  display:flex;
  flex-direction:column;
  min-height:210px;
}

.platform-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.platform-logo{
  width:50px;
  height:50px;
  border-radius:14px;
  display:grid;
  place-items:center;
  font-size:25px;
  background:#202c47;
}

.connection{
  margin-top:auto;
  padding-top:18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.connection-state{
  font-size:11px;
  color:var(--muted);
}

.connected{
  color:var(--success);
}

/* CALENDAR */
.schedule-list{
  display:grid;
  gap:10px;
}

.schedule-item{
  display:grid;
  grid-template-columns:85px 1fr auto;
  gap:15px;
  align-items:center;
  padding:15px;
  border:1px solid var(--border);
  background:#111a2d;
  border-radius:13px;
}

.schedule-date{
  text-align:center;
}

.schedule-date strong{
  display:block;
  font-size:19px;
}

.schedule-date span{
  color:var(--muted);
  font-size:10px;
}

.schedule-info h3{
  font-size:13px;
}

.schedule-info p{
  color:var(--muted);
  font-size:10px;
  margin-top:4px;
}

/* REPORT */
.report-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
  gap:15px;
}

.report-number{
  font-size:31px;
  font-weight:850;
}

.report-line{
  margin-top:14px;
}

.report-line-head{
  display:flex;
  justify-content:space-between;
  font-size:11px;
  margin-bottom:7px;
}

.progress{
  height:8px;
  border-radius:20px;
  background:#0b1221;
  overflow:hidden;
}

.progress span{
  display:block;
  height:100%;
  border-radius:20px;
  background:linear-gradient(90deg,var(--primary),var(--info));
}

/* AUTOMATION */
.automation-card{
  display:flex;
  gap:16px;
  align-items:flex-start;
}

.automation-icon{
  width:48px;
  height:48px;
  border-radius:14px;
  display:grid;
  place-items:center;
  background:rgba(108,92,231,.14);
  font-size:23px;
  flex:none;
}

.automation-content{
  flex:1;
}

.automation-content h3{
  font-size:14px;
  margin-bottom:5px;
}

.automation-content p{
  color:var(--muted);
  font-size:11px;
  line-height:1.5;
}

.switch{
  width:45px;
  height:24px;
  border-radius:20px;
  background:#303b54;
  position:relative;
  border:0;
  flex:none;
}

.switch span{
  position:absolute;
  width:18px;
  height:18px;
  left:3px;
  top:3px;
  border-radius:50%;
  background:#fff;
  transition:.2s;
}

.switch.on{
  background:var(--primary);
}

.switch.on span{
  left:24px;
}

/* MODAL */
.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.72);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:500;
  padding:20px;
}

.modal.open{
  display:flex;
}

.modal-box{
  width:min(620px,100%);
  max-height:90vh;
  overflow:auto;
  background:#101729;
  border:1px solid var(--border);
  border-radius:20px;
  padding:24px;
  box-shadow:0 30px 80px rgba(0,0,0,.45);
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.modal-header h2{
  font-size:20px;
}

.close{
  width:35px;
  height:35px;
  border:1px solid var(--border);
  background:#18233b;
  color:white;
  border-radius:9px;
}

.form-group{
  margin-bottom:14px;
}

.form-group label{
  display:block;
  font-size:11px;
  color:#aeb8ce;
  margin-bottom:6px;
}

.form-actions{
  display:flex;
  justify-content:flex-end;
  gap:8px;
  margin-top:20px;
}

/* TOAST */
.toast-container{
  position:fixed;
  right:20px;
  bottom:20px;
  z-index:1000;
  display:grid;
  gap:10px;
}

.toast{
  min-width:260px;
  max-width:350px;
  padding:14px 16px;
  border-radius:12px;
  background:#17223a;
  border:1px solid var(--border);
  box-shadow:var(--shadow);
  font-size:12px;
  animation:slideIn .25s ease;
}

.toast.success{
  border-left:4px solid var(--success);
}

.toast.error{
  border-left:4px solid var(--danger);
}

.toast.info{
  border-left:4px solid var(--info);
}

@keyframes slideIn{
  from{transform:translateX(30px);opacity:0}
  to{transform:translateX(0);opacity:1}
}

/* MOBILE */
@media(max-width:1050px){
  .grid-4{
    grid-template-columns:repeat(2,1fr);
  }

  .video-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:780px){
  .sidebar{
    transform:translateX(-100%);
    transition:.25s;
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
  }

  .mobile-menu{
    display:block;
  }

  .topbar{
    padding:0 15px;
    gap:10px;
  }

  .profile-mini span{
    display:none;
  }

  .content{
    padding:18px 14px;
  }

  .welcome{
    padding:19px;
  }

  .welcome h2{
    font-size:20px;
  }

  .welcome-icon{
    font-size:40px;
  }

  .grid-2,
  .grid-3,
  .grid-4,
  .video-grid{
    grid-template-columns:1fr;
  }

  .search{
    min-width:0;
    width:100%;
  }

  .toolbar-left,
  .toolbar-right{
    width:100%;
  }

  .toolbar .btn{
    flex:1;
  }

  .schedule-item{
    grid-template-columns:65px 1fr;
  }

  .schedule-item > .badge{
    grid-column:2;
    justify-self:start;
  }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">

  <div class="logo">
    <div class="logo-icon">🎬</div>
    <div>
      <strong>CineFlow</strong>
      <small>CONTENT MANAGEMENT</small>
    </div>
  </div>

  <div class="nav-title">Principal</div>

  <button class="nav-btn active" data-section="dashboard">
    <span class="nav-icon">📊</span>
    Tableau de bord
  </button>

  <button class="nav-btn" data-section="videos">
    <span class="nav-icon">🎥</span>
    Mes vidéos
  </button>

  <button class="nav-btn" data-section="planning">
    <span class="nav-icon">📅</span>
    Planning
  </button>

  <div class="nav-title">Gestion</div>

  <button class="nav-btn" data-section="platforms">
    <span class="nav-icon">🔗</span>
    Plateformes
  </button>

  <button class="nav-btn" data-section="automation">
    <span class="nav-icon">⚡</span>
    Automatisation
  </button>

  <button class="nav-btn" data-section="reports">
    <span class="nav-icon">📈</span>
    Rapports
  </button>

  <div class="nav-title">Compte</div>

  <button class="nav-btn" data-section="settings">
    <span class="nav-icon">⚙️</span>
    Paramètres
  </button>

  <div class="sidebar-bottom">
    <p>
      <span class="status-dot"></span>
      CineFlow est prêt
    </p>
    <p style="margin-top:7px">
      Ton espace centralisé pour gérer tes contenus vidéo.
    </p>
  </div>

</aside>

<!-- MAIN -->
<main class="main">

  <header class="topbar">

    <div style="display:flex;align-items:center;gap:12px">

      <button class="mobile-menu" id="mobileMenu">☰</button>

      <div class="page-title">
        <h1 id="pageTitle">Tableau de bord</h1>
        <p id="pageSubtitle">Vue générale de ton activité</p>
      </div>

    </div>

    <div class="top-actions">

      <button class="icon-btn" onclick="showToast('Aucune nouvelle notification','info')">
        🔔
        <span class="notification-dot"></span>
      </button>

      <div class="profile-mini">
        <div class="avatar">👤</div>
        <span>Créateur</span>
      </div>

    </div>

  </header>

  <div class="content">

    <!-- DASHBOARD -->
    <section class="section active" id="dashboard">

      <div class="welcome">

        <div>
          <h2>Bienvenue sur CineFlow 👋</h2>
          <p>
            Organise, programme et suis tes contenus vidéo depuis un seul espace.
          </p>
        </div>

        <div class="welcome-icon">🎬</div>

      </div>

      <div class="grid grid-4">

        <div class="card stat-card">
          <div class="stat-icon">🎥</div>
          <div class="stat-value" id="statVideos">12</div>
          <div class="stat-label">Vidéos gérées</div>
          <div class="stat-change">↑ activité en progression</div>
        </div>

        <div class="card stat-card">
          <div class="stat-icon">📤</div>
          <div class="stat-value" id="statPublished">7</div>
          <div class="stat-label">Vidéos publiées</div>
          <div class="stat-change">↑ cette période</div>
        </div>

        <div class="card stat-card">
          <div class="stat-icon">👁️</div>
