      <label>Description</label>
      <textarea class="textarea" id="newVideoDescription" rows="4" placeholder="Description du contenu..."></textarea>
    </div>

    <div class="form-group">
      <label>Plateformes</label>
      <select class="select" id="newVideoPlatform">
        <option>YouTube</option>
        <option>TikTok</option>
        <option>Instagram</option>
        <option>YouTube + TikTok</option>
        <option>YouTube + TikTok + Instagram</option>
      </select>
    </div>

    <div class="form-group">
      <label>Statut</label>
      <select class="select" id="newVideoStatus">
        <option value="draft">Brouillon</option>
        <option value="scheduled">Programmé</option>
        <option value="published">Publié</option>
      </select>
    </div>

    <div class="form-actions">
      <button class="btn" onclick="closeModal('videoModal')">
        Annuler
      </button>

      <button class="btn btn-primary" onclick="addVideo()">
        Ajouter
      </button>
    </div>

  </div>

</div>


<!-- MODAL PLANNING -->
<div class="modal" id="scheduleModal">

  <div class="modal-box">

    <div class="modal-header">
      <h2>Programmer une publication</h2>
      <button class="close" onclick="closeModal('scheduleModal')">✕</button>
    </div>

    <div class="form-group">
      <label>Titre</label>
      <input class="input" id="scheduleTitle" placeholder="Titre de la vidéo">
    </div>

    <div class="form-group">
      <label>Date</label>
      <input class="input" type="date" id="scheduleDate">
    </div>

    <div class="form-group">
      <label>Heure</label>
      <input class="input" type="time" id="scheduleTime" value="18:00">
    </div>

    <div class="form-group">
      <label>Plateforme</label>
      <select class="select" id="schedulePlatform">
        <option>YouTube</option>
        <option>TikTok</option>
        <option>Instagram</option>
        <option>YouTube + TikTok</option>
        <option>YouTube + TikTok + Instagram</option>
      </select>
    </div>

    <div class="form-actions">
      <button class="btn" onclick="closeModal('scheduleModal')">
        Annuler
      </button>

      <button class="btn btn-primary" onclick="addSchedule()">
        Programmer
      </button>
    </div>

  </div>

</div>


<div class="toast-container" id="toastContainer"></div>


<script>

/* =========================================================
   CINEFLOW
   APPLICATION FRONT-END
   VERSION DE RÉFÉRENCE
========================================================= */


/* NAVIGATION */

const navButtons = document.querySelectorAll(".nav-btn");
const sections = document.querySelectorAll(".section");

const pageData = {

  dashboard:{
    title:"Tableau de bord",
    subtitle:"Vue générale de ton activité"
  },

  videos:{
    title:"Mes vidéos",
    subtitle:"Gère tous tes contenus vidéo"
  },

  planning:{
    title:"Planning",
    subtitle:"Programme tes prochaines publications"
  },

  platforms:{
    title:"Plateformes",
    subtitle:"Centralise tes réseaux vidéo"
  },

  automation:{
    title:"Automatisation",
    subtitle:"Configure tes tâches automatisées"
  },

  reports:{
    title:"Rapports",
    subtitle:"Analyse tes performances"
  },

  settings:{
    title:"Paramètres",
    subtitle:"Personnalise ton espace CineFlow"
  }

};


navButtons.forEach(button=>{

  button.addEventListener("click",()=>{

    const target = button.dataset.section;

    navButtons.forEach(btn=>{
      btn.classList.remove("active");
    });

    button.classList.add("active");

    sections.forEach(section=>{
      section.classList.remove("active");
    });

    const targetSection = document.getElementById(target);

    if(targetSection){
      targetSection.classList.add("active");
    }

    document.getElementById("pageTitle").textContent =
      pageData[target].title;

    document.getElementById("pageSubtitle").textContent =
      pageData[target].subtitle;

    document.getElementById("sidebar").classList.remove("open");

    window.scrollTo({
      top:0,
      behavior:"smooth"
    });

  });

});


/* MOBILE MENU */

document.getElementById("mobileMenu").addEventListener("click",()=>{

  document.getElementById("sidebar").classList.toggle("open");

});


/* MODALS */

function openModal(id){

  const modal = document.getElementById(id);

  if(modal){
    modal.classList.add("open");
  }

}


function closeModal(id){

  const modal = document.getElementById(id);

  if(modal){
    modal.classList.remove("open");
  }

}


document.querySelectorAll(".modal").forEach(modal=>{

  modal.addEventListener("click",(event)=>{

    if(event.target === modal){
      modal.classList.remove("open");
    }

  });

});


/* TOAST */

function showToast(message,type="info"){

  const container =
    document.getElementById("toastContainer");

  const toast =
    document.createElement("div");

  toast.className = "toast " + type;

  toast.textContent = message;

  container.appendChild(toast);

  setTimeout(()=>{

    toast.style.opacity = "0";
    toast.style.transform = "translateX(20px)";

    setTimeout(()=>{
      toast.remove();
    },250);

  },3000);

}


/* PLATFORM CONNECTION */

function connectPlatform(name,stateId){

  const state =
    document.getElementById(stateId);

  if(!state){
    return;
  }

  state.textContent = "Connexion active";
  state.classList.add("connected");

  showToast(
    name + " est maintenant connecté dans CineFlow.",
    "success"
  );

}


/* SWITCH */

function toggleSwitch(button){

  button.classList.toggle("on");

  const enabled =
    button.classList.contains("on");

  showToast(
    enabled
      ? "Fonction activée."
      : "Fonction désactivée.",
    enabled ? "success" : "info"
  );

}


/* ADD VIDEO */

function addVideo(){

  const title =
    document.getElementById("newVideoTitle").value.trim();

  const description =
    document.getElementById("newVideoDescription").value.trim();

  const platform =
    document.getElementById("newVideoPlatform").value;

  const status =
    document.getElementById("newVideoStatus").value;

  if(!title){

    showToast(
      "Ajoute un titre à la vidéo.",
      "error"
    );

    return;
  }

  const statusText = {

    published:"Publié",
    scheduled:"Programmé",
    draft:"Brouillon"

  }[status];

  const statusClass = {

    published:"badge-success",
    scheduled:"badge-info",
    draft:"badge-warning"

  }[status];

  let icons = "▶️";

  if(platform.includes("TikTok")){
    icons += " ♪";
  }

  if(platform.includes("Instagram")){
    icons += " ◎";
  }

  const card =
    document.createElement("article");

  card.className =
    "card video-card";

  card.dataset.status =
    status;

  card.innerHTML = `

    <div class="video-thumb">
      🎬
      <span class="video-duration">--:--</span>
    </div>

    <div class="video-body">

      <h3>${escapeHtml(title)}</h3>

      <p>
        ${escapeHtml(
          description ||
          "Nouveau contenu ajouté à CineFlow."
        )}
      </p>

      <div class="video-meta">

        <div class="platforms">
          <span class="platform">${icons}</span>
        </div>

        <span class="badge ${statusClass}">
          ${statusText}
        </span>

      </div>

    </div>
  `;

  document
    .getElementById("videoGrid")
    .prepend(card);

  const current =
    parseInt(
      document.getElementById("statVideos").textContent
    ) || 0;

  document.getElementById("statVideos").textContent =
    current + 1;

  document.getElementById("newVideoTitle").value = "";
  document.getElementById("newVideoDescription").value = "";

  closeModal("videoModal");

  showToast(
    "Vidéo ajoutée à CineFlow.",
    "success"
  );

}


/* FILTER VIDEOS */

function filterVideos(){

  const search =
    document
      .getElementById("videoSearch")
      .value
      .toLowerCase();

  const filter =
    document
      .getElementById("videoFilter")
      .value;

  const cards =
    document.querySelectorAll(".video-card");

  cards.forEach(card=>{

    const title =
      card
        .querySelector("h3")
        .textContent
        .toLowerCase();

    const status =
      card.dataset.status;

    const matchSearch =
      title.includes(search);

    const matchFilter =
      filter === "all" ||
      status === filter;

    card.style.display =
      matchSearch && matchFilter
        ? ""
        : "none";

  });

}


/* ADD SCHEDULE */

function addSchedule(){

  const title =
    document
      .getElementById("scheduleTitle")
      .value
      .trim();

  const date =
    document
      .getElementById("scheduleDate")
      .value;

  const time =
    document
      .getElementById("scheduleTime")
      .value;

  const platform =
    document
      .getElementById("schedulePlatform")
      .value;

  if(!title || !date){

    showToast(
      "Complète le titre et la date.",
      "error"
    );

    return;
  }

  const dateObject =
    new Date(date + "T00:00:00");

  const day =
    String(dateObject.getDate())
      .padStart(2,"0");

  const monthNames = [
    "JAN","FÉV","MAR","AVR","MAI","JUIN",
    "JUIL","AOÛ","SEP","OCT","NOV","DÉC"
  ];

  const month =
    monthNames[dateObject.getMonth()];

  const item =
    document.createElement("div");

  item.className =
    "schedule-item";

  item.innerHTML = `

    <div class="schedule-date">
      <strong>${day}</strong>
      <span>${month}</span>
    </div>

    <div class="schedule-info">
      <h3>${escapeHtml(title)}</h3>
      <p>${escapeHtml(platform)}</p>
    </div>

    <span class="badge badge-info">
      ${escapeHtml(time)}
    </span>
  `;

  document
    .querySelector("#planning .schedule-list")
    .appendChild(item);

  document.getElementById("scheduleTitle").value = "";

  closeModal("scheduleModal");

  showToast(
    "Publication programmée avec succès.",
    "success"
  );

}


/* REPORT */

function generateReport(){

  showToast(
    "Le rapport mensuel est prêt à être préparé.",
    "success"
  );

}


/* SETTINGS */

function saveSettings(){

  const name =
    document
      .getElementById("creatorName")
      .value
      .trim();

  if(name){

    document.querySelector(
      ".profile-mini span"
    ).textContent = name;

  }

  showToast(
    "Paramètres enregistrés.",
    "success"
  );

}


/* SECURITY / TEXT */

function escapeHtml(value){

  return String(value)

    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}


/* KEYBOARD */

document.addEventListener("keydown",(event)=>{

  if(event.key === "Escape"){

    document
      .querySelectorAll(".modal.open")
      .forEach(modal=>{
        modal.classList.remove("open");
      });

  }

});


/* INITIALISATION */

document.addEventListener("DOMContentLoaded",()=>{

  showToast(
    "Bienvenue dans CineFlow.",
    "success"
  );

});


</script>

</body>
</html>
